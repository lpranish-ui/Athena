# ── Athena — public app configuration ─────────────────────────────────────────
# Copy this file to `.env` in the project root and fill in your values.
# These two variables are safe to ship to the client (they are read by the app).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# ── Server-side secret (do NOT put it here) ───────────────────────────────────
# The DeepSeek API key lives only on the server. Set it as a Supabase secret:
#
#   supabase secrets set DEEPSEEK_API_KEY=sk-your-deepseek-key
#
# Get a key at https://platform.deepseek.com/api_keys
