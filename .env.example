# ── Athena — public app configuration ─────────────────────────────────────────
# Copy this file to `.env` in the project root and fill in your values.
# Safe to ship to the client: it is only the address of the Athena API.

EXPO_PUBLIC_API_URL=https://athena-api-w018.onrender.com

