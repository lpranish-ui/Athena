# Athena API — local development environment.
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.

# Render Postgres connection string.
# - On Render (internal): postgresql://<user>:<pass>@<host-id>/<database>
# - From your machine (external): use the full ...oregon-postgres.render.com host.
DATABASE_URL=postgresql://user:pass@host/athena

# Secret used to sign sign-in tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# DeepSeek AI (server-side only — never ship this in the app).
DEEPSEEK_API_KEY=
# Cheapest model first; switch to a stronger one any time without code changes.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VERIFY_MODEL=deepseek-flash
